@page "/manager-dashboard"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer

@using Employees.UI.Services
@using Employees.UI.Models

@inject UserSession Session
@inject NavigationManager Navigation
@inject HttpClientWrapper Http

<PageTitle>Manager Dashboard</PageTitle>

<div class="container mt-4">

    <!-- DASHBOARD HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Manager Dashboard</h2>
            <p class="mb-0">Welcome, @Session.Name</p>
        </div>

        <button class="btn btn-outline-danger"
                @onclick="Logout">
            <i class="bi bi-box-arrow-right me-2"></i>
            Logout
        </button>

    </div>

    <!-- MANAGER LEAVE OPTIONS -->

    <h4 class="mt-3 mb-3">Leave Management</h4>

    <div class="row g-3">

        <!-- APPLY LEAVE -->

        <div class="col-md-6">

            <div class="card shadow h-100 border-primary">

                <div class="card-body">

                    <h4>
                        <i class="bi bi-calendar-plus text-primary me-2"></i>
                        Apply Leave
                    </h4>

                    <p>
                        Apply for leave and send your request
                        to Admin for approval.
                    </p>

                    <button class="btn btn-primary w-100"
                            @onclick="ApplyLeave">

                        <i class="bi bi-plus-circle me-2"></i>
                        Apply Leave

                    </button>

                </div>

            </div>

        </div>

        <!-- MY LEAVES -->

@*         <div class="col-md-6">

            <div class="card shadow h-100 border-success">

                <div class="card-body">

                    <h4>
                        <i class="bi bi-calendar2-check text-success me-2"></i>
                        My Leaves
                    </h4>

                    <p>
                        View your leave applications,
                        approval status and rejection reasons.
                    </p>

                    <button class="btn btn-success w-100"
                            @onclick="MyLeaves">

                        <i class="bi bi-eye me-2"></i>
                        View My Leaves

                    </button>

                </div>

            </div>

        </div> *@

        <div class="col-md-6 mt-3">
            <div class="card shadow h-100 border-success">
                <div class="card-body">

                    <h4>
                        <i class="bi bi-calendar-check me-2"></i>
                        My Leaves
                    </h4>

                    <p>
                        View your applied leave requests and approval status.
                    </p>

                    <button class="btn btn-success w-100"
                            @onclick="ViewMyLeaves">

                        View My Leaves

                    </button>

                </div>
            </div>
        </div>

        <!-- PENDING LEAVES -->

        <div class="col-md-6">

            <div class="card shadow h-100 border-warning">

                <div class="card-body">

                    <h4>
                        <i class="bi bi-calendar-check text-warning me-2"></i>
                        Pending Leaves
                    </h4>

                    <p>
                        View HR and Technical leave requests.
                        Approve or reject pending applications.
                    </p>

                    <button class="btn btn-warning w-100"
                            @onclick="OpenPendingLeaves">

                        <i class="bi bi-eye me-2"></i>
                        View Pending Leaves

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- CREATE HR AND TECHNICAL -->

    <h4 class="mt-4 mb-3">Account Management</h4>

    <div class="row g-3">

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4>HR</h4>

                    <p>Create an HR account.</p>

                    <button class="btn btn-primary w-100"
                            @onclick="CreateHR">

                        Create HR

                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4>Technical</h4>

                    <p>Create a Technical account.</p>

                    <button class="btn btn-success w-100"
                            @onclick="CreateTechnical">

                        Create Technical

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- LOADING -->
    @if (IsLoading)
    {
        <div class="text-center mt-4">

            <div class="spinner-border text-primary"></div>

            <p>Loading dashboard...</p>

        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-4">
            @ErrorMessage
        </div>
    }
    else if (Dashboard != null)
    {
        <!-- DASHBOARD STATISTICS -->

        <h4 class="mt-4">Dashboard Statistics</h4>

        <div class="row g-3 mt-2">

            <div class="col-md-4">

                <div class="card shadow border-primary">

                    <div class="card-body">

                        <h5>Total HR Created</h5>

                        <h2 class="text-primary">
                            @Dashboard.TotalHR
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow border-success">

                    <div class="card-body">

                        <h5>Total Technical Created</h5>

                        <h2 class="text-success">
                            @Dashboard.TotalTechnical
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow border-warning">

                    <div class="card-body">

                        <h5>Total Created</h5>

                        <h2 class="text-warning">
                            @Dashboard.TotalCreated
                        </h2>

                    </div>

                </div>

            </div>

        </div>

        <!-- HR USERS -->

        <div class="card shadow mt-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    HR Users Created by @Session.Name
                </h5>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                            </tr>

                        </thead>

                        <tbody>

                            @if (Dashboard.HRUsers.Any())
                            {
                                @foreach (var user in Dashboard.HRUsers)
                                {
                                    <tr>
                                        <td>@user.Id</td>
                                        <td>@user.Name</td>
                                        <td>@user.Email</td>
                                        <td>@user.Role</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">
                                        No HR users created yet.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- TECHNICAL USERS -->

        <div class="card shadow mt-4 mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">
                    Technical Users Created by @Session.Name
                </h5>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                            </tr>

                        </thead>

                        <tbody>

                            @if (Dashboard.TechnicalUsers.Any())
                            {
                                @foreach (var user in Dashboard.TechnicalUsers)
                                {
                                    <tr>
                                        <td>@user.Id</td>
                                        <td>@user.Name</td>
                                        <td>@user.Email</td>
                                        <td>@user.Role</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">
                                        No Technical users created yet.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    }

</div>

@code {

    private ManagerDashboardModel? Dashboard;

    private bool IsLoading = true;

    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn ||
            !string.Equals(
                Session.Role,
                "Manager",
                StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/manager-login");
            return;
        }

        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;

            Dashboard = await Http.GetManagerDashboard();

            if (Dashboard == null)
            {
                ErrorMessage = "Unable to load dashboard data.";
            }
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = $"API error: {ex.Message}";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading dashboard: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // APPLY LEAVE TO ADMIN
    private void ApplyLeave()
    {
        Navigation.NavigateTo("/apply-leave");
    }

    // VIEW OWN LEAVE HISTORY
    // private void MyLeaves()
    // {
    //     Navigation.NavigateTo("/my-leave");
    // }

    private void ViewMyLeaves()
    {
        Navigation.NavigateTo("/my-leaves");
    }

    private void CreateHR()
    {
        Navigation.NavigateTo("/create-hr");
    }

    private void CreateTechnical()
    {
        Navigation.NavigateTo("/create-technical");
    }

    private void OpenPendingLeaves()
    {
        Navigation.NavigateTo("/manage-leaves");
    }

    private void Logout()
    {
        Session.Logout();

        Navigation.NavigateTo("/manager-login");
    }
}
