@page "/manager-dashboard"
@rendermode InteractiveServer
@using Employees.UI.Services
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Manager Dashboard</PageTitle>

<div class="container mt-4">
    <h2>Manager Dashboard</h2>
    <p>Welcome, @Session.Name</p>

    <div class="row g-3 mt-3">
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>HR</h4>
                    <p>Create an HR account.</p>

                    <button class="btn btn-primary w-100"
                            @onclick="CreateHR">
                        Create HR
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Technical</h4>
                    <p>Create a Technical account.</p>

                    <button class="btn btn-success w-100"
                            @onclick="CreateTechnical">
                        Create Technical
                    </button>
                </div>
            </div>
        </div>
    </div>

    <button class="btn btn-outline-danger mt-4"
            @onclick="Logout">
        Logout
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn ||
            !string.Equals(Session.Role, "Manager",
                StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/manager-login");
        }
    }

    private void CreateHR()
    {
        Navigation.NavigateTo("/create-hr");
    }

    private void CreateTechnical()
    {
        Navigation.NavigateTo("/create-technical");
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/manager-login");
    }
}


