@page "/employee-dashboard"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer

@using Employees.UI.Services

@inject UserSession UserSession
@inject NavigationManager Navigation

<PageTitle>Employee Dashboard</PageTitle>

<div class="container mt-5">

    @if (!UserSession.IsLoggedIn)
    {
        <div class="alert alert-warning">
            Please login first.
        </div>
    }
    else if (!string.Equals(
        UserSession.Role?.Trim(),
        "Employee",
        StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-danger">
            You are not authorized to access this dashboard.
        </div>
    }
    else
    {
        <div class="card shadow">

            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                <h3 class="mb-0">Employee Dashboard</h3>

                <button class="btn btn-light btn-sm"
                        @onclick="Logout">

                    <i class="bi bi-box-arrow-right me-1"></i>
                    Logout

                </button>

            </div>

            <div class="card-body">

                <h4>Welcome, @UserSession.Name!</h4>

                <div class="alert alert-success mt-3">
                    Login successful.
                </div>

                <hr />

                <h5>My Profile</h5>

                <p>
                    <strong>Name:</strong>
                    @UserSession.Name
                </p>

                <p>
                    <strong>Email:</strong>
                    @UserSession.Email
                </p>

                <p>
                    <strong>Role:</strong>
                    @UserSession.Role
                </p>

                <p>
                    <strong>Department:</strong>
                    @UserSession.Department
                </p>

                <hr />

                <h5 class="mb-3">Leave Management</h5>

                <button class="btn btn-primary"
                        @onclick="ApplyLeave">

                    <i class="bi bi-calendar-plus me-2"></i>
                    Apply Leave

                </button>

                <button class="btn btn-success ms-2"
                        @onclick="ViewMyLeaves">

                    <i class="bi bi-calendar-check me-2"></i>
                    My Leave Requests

                </button>

                <hr />

            </div>
        </div>
    }

</div>

@code {

    protected override void OnInitialized()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void ApplyLeave()
    {
        Navigation.NavigateTo("/apply-leave");
    }

    private void Logout()
    {
        UserSession.Logout();

        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void ViewMyLeaves()
    {
        Navigation.NavigateTo("/my-leaves");
    }
}
