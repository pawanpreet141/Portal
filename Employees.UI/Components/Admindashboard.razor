@page "/admin-dashboard"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer

@using Employees.UI.Services

@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Admin Dashboard</h2>
            <p class="mb-0">
                Welcome, @Session.Name
            </p>
        </div>

        <button class="btn btn-outline-danger"
                @onclick="Logout">

            <i class="bi bi-box-arrow-right me-2"></i>
            Logout

        </button>

    </div>

    <div class="alert alert-info">
        Welcome to the Admin Dashboard.
        Manage managers and review leave requests here.
    </div>

    <div class="row g-4 mt-2">

        <!-- MANAGER MANAGEMENT -->

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="text-primary">
                        <i class="bi bi-people me-2"></i>
                        Manager Management
                    </h4>

                    <p>
                        Create and manage Manager accounts.
                    </p>

                    <button class="btn btn-primary w-100"
                            @onclick="CreateManager">

                        Create Manager

                    </button>

                </div>

            </div>

        </div>

        <!-- PENDING LEAVES -->

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="text-warning">
                        <i class="bi bi-calendar-check me-2"></i>
                        Pending Leave Requests
                    </h4>

                    <p>
                        View Manager leave requests.
                        Approve or reject leave applications.
                    </p>

                    <button class="btn btn-warning w-100"
                            @onclick="OpenPendingLeaves">

                        View Pending Leaves

                    </button>

                </div>

            </div>

        </div>


        </div>

            </div>


@code {

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn ||
            !string.Equals(
                Session.Role,
                "Admin",
                StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void CreateManager()
    {
        Navigation.NavigateTo("/create-manager");
    }

    private void OpenPendingLeaves()
    {
        Navigation.NavigateTo("/manage-leaves");
    }


    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/login");
    }
}
