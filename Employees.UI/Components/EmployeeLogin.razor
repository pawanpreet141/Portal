@page "/employee-login"

@using Employees.UI.Services
@using System.ComponentModel.DataAnnotations

@inject HttpClientWrapper Api
@inject UserSession UserSession
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Employee Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow">

                <div class="card-header bg-primary text-white text-center">
                    <h4>Employee Login</h4>
                </div>

                <div class="card-body p-4">

                    <EditForm Model="@loginModel"
                              OnValidSubmit="HandleLogin">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label>Email Address</label>

                            <InputText class="form-control"
                                       type="email"
                                       @bind-Value="loginModel.Email" />

                        </div>

                        <div class="mb-3">
                            <label>Password</label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="loginModel.Password" />

                        </div>

                        @if (!string.IsNullOrWhiteSpace(message))
                        {
                            <div class="alert alert-danger">
                                @message
                            </div>
                        }

                        <button type="submit"
                                class="btn btn-primary w-100"
                                disabled="@isBusy">

                            @(isBusy ? "Logging in..." : "Login")

                        </button>

                    </EditForm>

                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private LoginModel loginModel = new();

    private string message = "";

    private bool isBusy;

    private async Task HandleLogin()
    {
        message = "";

        if (isBusy)
            return;

        isBusy = true;

        try
        {
            var result = await Api.Login(new LoginRequest
            {
                Email = loginModel.Email,
                Password = loginModel.Password
            });

            if (result == null || !result.Success)
            {
                message = result?.Message ?? "Login failed.";
                return;
            }

            if (string.IsNullOrWhiteSpace(result.Token))
            {
                message = "JWT token not received.";
                return;
            }

            if (!string.Equals(
                result.Role?.Trim(),
                "Employee",
                StringComparison.OrdinalIgnoreCase))
            {
                message = "This login is only for employees.";
                return;
            }

            // Save employee session
            UserSession.Login(
                result.Id,
                result.Name,
                result.Email,
                result.Role,
                result.Department,
                result.Token);

            // Update authentication state
            AuthProvider.NotifyUserLogin();

            // Navigate to employee dashboard
            Navigation.NavigateTo("/employee-dashboard");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}
