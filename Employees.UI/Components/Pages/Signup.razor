@page "/signup"
@rendermode InteractiveServer
@using Employees.UI.Services
@inject HttpClientWrapper Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Employee Signup</PageTitle>

<div class="container mt-4">
    <div class="card shadow mx-auto" style="max-width:500px">
        <div class="card-header">
            <h3>Employee Signup</h3>
            <p>Manager: @Session.Name</p>
            <p>Department: @Session.Department</p>
            <p>Selected Team: @Department</p>
        </div>

        <div class="card-body">

            @if (!IsAllowedTeam)
            {
                <div class="alert alert-danger">
                    Invalid team or unauthorized department.
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control"
                           @bind="Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Team</label>
                    <select class="form-select" @bind="Department">
                        @foreach (var team in AvailableTeams)
                        {
                            <option value="@team">@team</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control"
                           type="email"
                           @bind="Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input class="form-control"
                           type="password"
                           @bind="Password" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input class="form-control"
                           type="password"
                           @bind="ConfirmPassword" />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="alert alert-success">
                    @SuccessMessage
                </div>
            }

            <button class="btn btn-success w-100"
                    @onclick="SignupUser"
                    disabled="@(!IsAllowedTeam || IsBusy)">
                @(IsBusy ? "Creating Account..." : "Sign Up")
            </button>

            <button class="btn btn-link w-100"
                    @onclick="BackToDashboard">
                Back to dashboard
            </button>
        </div>
    </div>
</div>