@page "/apply-leave"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer

@using Employees.UI.Models
@using Employees.UI.Services

@inject LeaveService LeaveService
@inject UserSession UserSession
@inject NavigationManager Navigation

<PageTitle>Apply Leave</PageTitle>

<div class="container mt-4">

    <div class="card shadow p-4">

        <h3 class="mb-3">Apply For Leave</h3>

        @if (UserSession.IsLoggedIn)
        {
            <div class="alert alert-info">
                <strong>User ID:</strong> @UserSession.UserId
                <br />
                <strong>Role:</strong> @UserSession.Role
                <br />
                <strong>Leave Approver:</strong> @ApproverRole
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(success
                 ? "alert-success"
                 : "alert-danger")">
                @message
            </div>
        }

        <EditForm Model="@request"
                  OnValidSubmit="SubmitLeave">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Leave Type</label>

                <InputSelect class="form-select"
                             @bind-Value="request.LeaveType">

                    <option value="">Select Leave Type</option>
                    <option value="Casual">Casual Leave</option>
                    <option value="Sick">Sick Leave</option>
                    @* <option value="Annual">Annual Leave</option> *@
                    <option value="Maternity">Maternity Leave</option>
                    <option value="Paternity">Paternity Leave</option>
                    <option value="Emergency">Emergency  </option>

				</InputSelect>
				<ValidationMessage For="@(() => request.LeaveType)" />

            </div>

            <div class="mb-3">
                <label class="form-label">From Date</label>

                <InputDate class="form-control"
                           @bind-Value="request.FromDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">To Date</label>

                <InputDate class="form-control"
                           @bind-Value="request.ToDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Reason</label>
                <InputTextArea class="form-control"
                               rows="4"
                               @bind-Value="request.Reason" />

                <ValidationMessage For="@(() => request.Reason)" />
            </div>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@isSubmitting">

                @(isSubmitting
                    ? "Submitting..."
                    : "Submit Leave")

            </button>

        </EditForm>

    </div>

</div>

@code {

    private ApplyLeaveRequest request = new();

    private string message = "";

    private bool success;
    private bool isSubmitting;

    // DETERMINE LEAVE APPROVER
    private string ApproverRole =>
        UserSession.Role?.Trim().ToLower() switch
        {
            "employee" => "HR / Technical",
            "hr" => "Manager",
            "technical" => "Manager",
            "manager" => "Admin",
            _ => "Not available"
        };


    // CHECK LOGIN AND ROLE
    protected override void OnInitialized()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var role = UserSession.Role?.Trim();

        if (role != null &&
            (role.Equals("Employee", StringComparison.OrdinalIgnoreCase) ||
             role.Equals("HR", StringComparison.OrdinalIgnoreCase) ||
             role.Equals("Technical", StringComparison.OrdinalIgnoreCase) ||
             role.Equals("Manager", StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        Navigation.NavigateTo("/login");
    }

    // SUBMIT LEAVE
    private async Task SubmitLeave()
    {
        if (isSubmitting)
            return;

        message = "";

        // VALIDATE FROM DATE
        if (request.FromDate.Date < DateTime.Today)
        {
            message = "From date cannot be in the past.";
            success = false;
            return;
        }

        // VALIDATE TO DATE
        if (request.ToDate.Date < request.FromDate.Date)
        {
            message = "To date cannot be earlier than From date.";
            success = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(request.LeaveType))
        {
            message = "Please select leave type.";
            success = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(request.Reason))
        {
            message = "Please enter leave reason.";
            success = false;
            return;
        }

        isSubmitting = true;

        try
        {
            ApiResponse result;

            var role = UserSession.Role?.Trim();

            // EMPLOYEE APPLIES TO HR OR TECHNICAL
            if (string.Equals(
                role, "Employee",
                StringComparison.OrdinalIgnoreCase))
            {
                result = await LeaveService.ApplyLeaveAsync(
                    request);
            }

            // HR OR TECHNICAL APPLIES TO MANAGER
            else if (
                string.Equals(
                    role, "HR",
                    StringComparison.OrdinalIgnoreCase) ||
                string.Equals(
                    role, "Technical",
                    StringComparison.OrdinalIgnoreCase))
            {
                result = await LeaveService.ApplyLeaveForManagerAsync(
                    request);
            }

            // MANAGER APPLIES TO ADMIN
            else if (string.Equals(
                role, "Manager",
                StringComparison.OrdinalIgnoreCase))
            {
                result = await LeaveService.ApplyLeaveForAdminAsync(
                    request);
            }

            else
            {
                message = "Unauthorized user role.";
                success = false;
                return;
            }

            success = result.Success;
            message = result.Message;

            if (result.Success)
            {
                request = new ApplyLeaveRequest();
            }
        }
        catch (Exception ex)
        {
            success = false;
            message = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
