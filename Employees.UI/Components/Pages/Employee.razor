@page "/employees"
@rendermode InteractiveServer

@using Employees.UI.Models
@using Employees.UI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClientWrapper HttpClient
@inject UserSession UserSession
@inject NavigationManager Navigation

<PageTitle>My Employees</PageTitle>

<div class="container mt-4">

    <h3>My Employees</h3>
    <p>Welcome, @UserSession.Name</p>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(IsSuccess ? "alert-success" : "alert-danger")">
            @Message
        </div>
    }

    <div class="mb-3">

        <button class="btn btn-primary"
                @onclick="ShowAddForm">
            Add Employee
        </button>

        <button class="btn btn-outline-danger ms-2"
                @onclick="Logout">
            Logout
        </button>

    </div>


    @if (showForm)
    {
        <!-- SHOW ONLY FORM -->

        <div class="card mb-4">

            <div class="card-header">
                <strong>
                    @(editingId == 0 ? "Add Employee" : "Edit Employee")
                </strong>
            </div>

            <div class="card-body">

                <EditForm Model="employee"
                          OnValidSubmit="SaveEmployee">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label>Name</label>
                        <InputText class="form-control"
                                   @bind-Value="employee.Name" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="employee.Email" />
                    </div>

                    <div class="mb-3">
                        <label>Department</label>

                        <InputSelect class="form-select"
                                     @bind-Value="employee.Team">

                            <option value="">Select Department</option>

                            @if (UserSession.Role == "HR")
                            {
                                <option value="Designer">Designer</option>
                                <option value="Development">Development</option>
                                <option value="Sales">Sales</option>
                                <option value="SEO">SEO</option>
                            }
                            else if (UserSession.Role == "Technical")
                            {
                                <option value="DevOps">DevOps</option>
                                <option value="System Engineer">System Engineer</option>
                            }

                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label>Age</label>
                        <InputNumber class="form-control"
                                     @bind-Value="employee.Age" />
                    </div>

                    <div class="mb-3">
                        <label>Salary</label>
                        <InputNumber class="form-control"
                                     @bind-Value="employee.Salary" />
                    </div>

                    @if (editingId == 0)
                    {
                        <div class="mb-3">
                            <label>Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="employeePassword" />
                        </div>
                    }

                    <button type="submit"
                            class="btn btn-success"
                            disabled="@IsBusy">
                        @(IsBusy ? "Saving..." : "Save")
                    </button>

                    <button type="button"
                            class="btn btn-secondary ms-2"
                            @onclick="Cancel"
                            disabled="@IsBusy">
                        Cancel
                    </button>

                </EditForm>

            </div>
        </div>
    }
    else
    {
        <!-- SHOW ONLY EMPLOYEE LIST -->

        @if (employees == null)
        {
            <p>Loading employees...</p>
        }
        else if (!employees.Any())
        {
            <div class="alert alert-info">
                No employees created by you yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in employees)
                        {
                            <tr @key="item.Id">
                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.Department</td>

                                <td>
                                    <button class="btn btn-sm btn-warning me-2"
                                            @onclick="() => EditEmployee(item)">
                                        Edit
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeleteEmployee(item.Id)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
    }

</div>
