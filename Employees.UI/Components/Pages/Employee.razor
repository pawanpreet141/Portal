@page "/employees"
@rendermode InteractiveServer

@using Employees.UI.Models
@using Employees.UI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClientWrapper HttpClient
@inject UserSession UserSession
@inject NavigationManager Navigation

<PageTitle>My Employees</PageTitle>

<div class="container mt-4">

    <h3>My Employees</h3>
    <p>Welcome, @UserSession.Name</p>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(IsSuccess ? "alert-success" : "alert-danger")">
            @Message
        </div>
    }

    <div class="mb-3">
        <button class="btn btn-primary"
                @onclick="ShowAddForm">
            Add Employee
        </button>

        <button class="btn btn-outline-danger ms-2"
                @onclick="Logout">
            Logout
        </button>
    </div>

    @if (showForm)
    {
        <div class="card mb-4">

            <div class="card-header">
                <strong>
                    @(editingId == 0 ? "Add Employee" : "Edit Employee")
                </strong>
            </div>

            <div class="card-body">

                <EditForm Model="employee"
                          OnValidSubmit="SaveEmployee">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Name</label>

                        <InputText class="form-control"
                                   @bind-Value="employee.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>

                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="employee.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Department</label>

                        <InputSelect class="form-select"
                                     @bind-Value="employee.Team">

                            <option value="">Select Department</option>

                            @if (string.Equals(
                                UserSession.Role,
                                "HR",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Designer">Designer</option>
                                <option value="Development">Development</option>
                                <option value="Sales">Sales</option>
                                <option value="SEO">SEO</option>
                            }
                            else if (string.Equals(
                                UserSession.Role,
                                "Technical",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="DevOps">DevOps</option>
                                <option value="System Engineer">System Engineer</option>
                            }

                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Age</label>

                        <InputNumber class="form-control"
                                     @bind-Value="employee.Age" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Salary</label>

                        <InputNumber class="form-control"
                                     @bind-Value="employee.Salary" />
                    </div>

                    <button type="submit"
                            class="btn btn-success me-2"
                            disabled="@IsBusy">
                        @(IsBusy ? "Saving..." : "Save")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Cancel"
                            disabled="@IsBusy">
                        Cancel
                    </button>

                </EditForm>

            </div>
        </div>
    }

    @if (employees == null)
    {
        <p><em>Loading employees...</em></p>
    }
    else if (!employees.Any())
    {
        <div class="alert alert-info">
            No employees created by you yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in employees)
                    {
                        <tr @key="item.Id">

                            <td>@item.Name</td>

                            <td>@item.Email</td>

                            <td>@item.Department</td>

                            <td>
                                <button class="btn btn-sm btn-warning me-2"
                                        @onclick="() => EditEmployee(item)"
                                        disabled="@IsBusy">
                                    Edit
                                </button>

                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => DeleteEmployee(item.Id)"
                                        disabled="@IsBusy">
                                    Delete
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
