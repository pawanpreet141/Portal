@page "/employees"
@rendermode InteractiveServer

@using Employees.UI.Models
@using Employees.UI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject UserSession UserSession
@inject NavigationManager Navigation
@inject HttpClientWrapper HttpClient

<PageTitle>My Employees</PageTitle>

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>

            <h3>My Employees</h3>

            <p class="text-muted mb-3">
                Welcome, @UserSession.Name
            </p>

            <button class="btn btn-primary"
                    @onclick="ShowAddForm">

                <i class="bi bi-person-plus me-1"></i>
                Add Employee

            </button>

        </div>

        <div class="d-flex gap-2">


            @if (UserSession.IsLoggedIn &&
    (UserSession.Role?.Equals(
        "HR",
        StringComparison.OrdinalIgnoreCase) == true ||
     UserSession.Role?.Equals(
        "Technical",
        StringComparison.OrdinalIgnoreCase) == true))
            {
                <div class="d-flex gap-2 mt-3">

                    <button class="btn btn-primary"
                            @onclick="ApplyLeave">
                        <i class="bi bi-calendar-plus me-2"></i>
                        Apply Leave
                    </button>

                    <button class="btn btn-success"
                            @onclick="MyLeaves">
                        <i class="bi bi-calendar-check me-2"></i>
                        My Leaves
                    </button>

                </div>
            }



            @if (UserSession.Role == "HR" ||
                 UserSession.Role == "Technical")
            {
                <button class="btn btn-warning"
                        @onclick="OpenPendingLeaves">

                    <i class="bi bi-calendar-check me-1"></i>
                    Pending Leave Requests

                </button>
            }

            <button class="btn btn-outline-danger"
                    @onclick="Logout">

                <i class="bi bi-box-arrow-right me-1"></i>
                Logout

            </button>

        </div>

    </div>

    <hr />

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(IsSuccess ? "alert-success" : "alert-danger")">
            @Message
        </div>
    }

    @if (showForm)
    {
        <!-- ADD / EDIT EMPLOYEE FORM -->

        <div class="card mb-4 shadow-sm">

            <div class="card-header">
                <strong>
                    @(editingId == 0 ? "Add Employee" : "Edit Employee")
                </strong>
            </div>

            <div class="card-body">

                <EditForm Model="employee"
                          OnValidSubmit="SaveEmployee">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label>Name</label>
                        <InputText class="form-control"
                                   @bind-Value="employee.Name" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="employee.Email" />
                    </div>

                    <div class="mb-3">
                        <label>Department</label>

                        <InputSelect class="form-select"
                                     @bind-Value="employee.Team">

                            <option value="">Select Department</option>

                            @if (UserSession.Role == "HR")
                            {
                                <option value="Designer">Designer</option>
                                <option value="Development">Development</option>
                                <option value="Sales">Sales</option>
                                <option value="SEO">SEO</option>
                            }
                            else if (UserSession.Role == "Technical")
                            {
                                <option value="DevOps">DevOps</option>
                                <option value="System Engineer">System Engineer</option>
                            }

                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label>Age</label>
                        <InputNumber class="form-control"
                                     @bind-Value="employee.Age" />
                    </div>

                    <div class="mb-3">
                        <label>Salary</label>
                        <InputNumber class="form-control"
                                     @bind-Value="employee.Salary" />
                    </div>

                    @if (editingId == 0)
                    {
                        <div class="mb-3">
                            <label>Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="employeePassword" />
                        </div>
                    }

                    <button type="submit"
                            class="btn btn-success"
                            disabled="@IsBusy">

                        @(IsBusy ? "Saving..." : "Save")

                    </button>

                    <button type="button"
                            class="btn btn-secondary ms-2"
                            @onclick="Cancel"
                            disabled="@IsBusy">

                        Cancel

                    </button>

                </EditForm>

            </div>
        </div>
    }
    else
    {
        <!-- EMPLOYEE LIST -->
        @if (employees == null)
        {
            <p>Loading employees...</p>
        }
        else if (!employees.Any())
        {
            <div class="alert alert-info">
                No employees created by you yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in employees)
                        {
                            <tr @key="item.Id">

                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.Department</td>

                                <td>

                                    <button class="btn btn-sm btn-warning me-2"
                                            @onclick="() => EditEmployee(item)">

                                        Edit

                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeleteEmployee(item.Id)">

                                        Delete

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
    }

</div>
