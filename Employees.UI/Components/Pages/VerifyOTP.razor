@page "/verify-otp"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.WebUtilities
@using Employees.UI.Services

@inject NavigationManager Navigation
@inject HttpClientWrapper Api

<PageTitle>Verify OTP</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h3>Verify OTP</h3>
                </div>

                <div class="card-body">

                    <p class="text-muted text-center">
                        Enter the 6-digit OTP sent to your email.
                    </p>

                    <div class="mb-3">
                        <label>Email Address</label>

                        <input type="email"
                               class="form-control"
                               value="@Email"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label>Enter OTP</label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter 6-digit OTP"
                               maxlength="6"
                               inputmode="numeric"
                               @bind="OTP" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                    {
                        <div class="alert alert-success">
                            @SuccessMessage
                        </div>
                    }

                    <button class="btn btn-primary w-100"
                            @onclick="VerifyOtp"
                            disabled="@IsLoading">

                        @if (IsLoading)
                        {
                            <span>Verifying...</span>
                        }
                        else
                        {
                            <span>Verify OTP</span>
                        }

                    </button>

                    @* <div class="text-center mt-4">

                        <p class="mb-2">
                            Resend OTP
                        </p>

                        @if (RemainingSeconds > 0)
                        {
                            <h4 class="text-primary">
                                @FormattedTime
                            </h4>

                            <p class="text-muted small">
                                You can resend OTP when the timer ends.
                            </p>
                        }
                        else
                        {
                            <p class="text-success">
                                You can request a new OTP now.
                            </p>
                        }

                        <button class="btn btn-outline-primary w-100"
                                @onclick="ResendOtp"
                                disabled="@(RemainingSeconds > 0 || IsResending)">

                            @if (IsResending)
                            {
                                <span>Sending...</span>
                            }
                            else if (RemainingSeconds > 0)
                            {
                                <span>Resend OTP (@FormattedTime)</span>
                            }
                            else
                            {
                                <span>Resend OTP</span>
                            }

                        </button>

                    </div> *@

                    <div class="text-center mt-4">

                        <button class="btn btn-outline-primary w-100"
                                @onclick="ResendOtp"
                                disabled="@(RemainingSeconds > 0 || IsResending)">

                            @if (IsResending)
                            {
                                <span>Sending...</span>
                            }
                            else if (RemainingSeconds > 0)
                            {
                                <span>Resend OTP (@FormattedTime)</span>
                            }
                            else
                            {
                                <span>Resend OTP</span>
                            }

                        </button>

                        @if (RemainingSeconds > 0)
                        {
                            <p class="text-muted small mt-2">
                                You can resend OTP when the timer ends.
                            </p>
                        }
                        else if (!IsResending)
                        {
                            <p class="text-success small mt-2">
                                You can request a new OTP now.
                            </p>
                        }

                    </div>

                    <div class="text-center mt-3">
                        <a href="/forgot-password">
                            Back
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@code {

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string OTP = string.Empty;

    private string ErrorMessage = string.Empty;

    private string SuccessMessage = string.Empty;

    private bool IsLoading = false;

    private bool IsResending = false;

    private int RemainingSeconds = 0;

    private CancellationTokenSource? timerCancellation;

    private string FormattedTime =>
        $"{RemainingSeconds / 60:D2}:{RemainingSeconds % 60:D2}";


    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Email address is missing.";
            return;
        }

        // Get actual cooldown from backend.
        RemainingSeconds =
            await Api.GetOtpResendWaitSeconds(Email.Trim());

        StartCountdown();
    }


    private void StartCountdown()
    {
        timerCancellation?.Cancel();
        timerCancellation?.Dispose();

        timerCancellation = new CancellationTokenSource();

        _ = RunCountdown(timerCancellation.Token);
    }


    private async Task RunCountdown(CancellationToken token)
    {
        try
        {
            while (RemainingSeconds > 0 && !token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);

                await InvokeAsync(() =>
                {
                    if (RemainingSeconds > 0)
                    {
                        RemainingSeconds--;
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Timer stopped.
        }
    }


    private async Task ResendOtp()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Email address is missing.";
            return;
        }

        if (RemainingSeconds > 0 || IsResending)
            return;

        IsResending = true;

        try
        {
            var result = await Api.ResendPasswordOtp(Email.Trim());

            if (result.Success)
            {
                OTP = string.Empty;

                SuccessMessage = "A new OTP has been sent to your email.";

                RemainingSeconds = 30;

                StartCountdown();
            }
            else
            {
                ErrorMessage = result.Message;

                // Synchronize timer with server if request was too early.
                if (result.RetryAfterSeconds > 0)
                {
                    RemainingSeconds = result.RetryAfterSeconds;
                    StartCountdown();
                }
            }
        }
        catch
        {
            ErrorMessage = "Unable to resend OTP. Please try again.";
        }
        finally
        {
            IsResending = false;
        }
    }


    private async Task VerifyOtp()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Email address is missing.";
            return;
        }

        if (string.IsNullOrWhiteSpace(OTP) ||
            OTP.Length != 6 ||
            !OTP.All(char.IsDigit))
        {
            ErrorMessage = "Please enter a valid 6-digit OTP.";
            return;
        }

        IsLoading = true;

        try
        {
            var result = await Api.VerifyPasswordOtp(
                Email.Trim(),
                OTP.Trim());

            if (result.Success &&
                !string.IsNullOrWhiteSpace(result.ResetToken))
            {
                Navigation.NavigateTo(
                    "/change-password?email=" +
                    Uri.EscapeDataString(Email.Trim()) +
                    "&resetToken=" +
                    Uri.EscapeDataString(result.ResetToken));
            }
            else
            {
                ErrorMessage = result.Message;
            }
        }
        catch
        {
            ErrorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    public ValueTask DisposeAsync()
    {
        timerCancellation?.Cancel();
        timerCancellation?.Dispose();

        return ValueTask.CompletedTask;
    }
}
