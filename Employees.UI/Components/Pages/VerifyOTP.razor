@page "/verify-otp"
@layout Employees.UI.Components.Layout.Layout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.WebUtilities
@using Employees.UI.Services

@inject NavigationManager Navigation
@inject HttpClientWrapper Api

<PageTitle>Verify OTP</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h3>Verify OTP</h3>
                </div>

                <div class="card-body">

                    <p class="text-muted text-center">
                        Enter the 6-digit OTP sent to your email.
                    </p>

                    <div class="mb-3">
                        <label>Email Address</label>

                        <input type="email"
                               class="form-control"
                               value="@Email"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label>Enter OTP</label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter 6-digit OTP"
                               maxlength="6"
                               inputmode="numeric"
                               @bind="OTP" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @ErrorMessage
                        </div>
                    }

                    <button class="btn btn-primary w-100"
                            @onclick="VerifyOtp"
                            disabled="@IsLoading">

                        @if (IsLoading)
                        {
                            <span>Verifying...</span>
                        }
                        else
                        {
                            <span>Verify OTP</span>
                        }

                    </button>

                    <div class="text-center mt-3">
                        <a href="/forgot-password">
                            Back
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string OTP = string.Empty;

    private string ErrorMessage = string.Empty;

    private bool IsLoading = false;

    private async Task VerifyOtp()
    {
        ErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Email address is missing.";
            return;
        }

        if (string.IsNullOrWhiteSpace(OTP) ||
            OTP.Length != 6 ||
            !OTP.All(char.IsDigit))
        {
            ErrorMessage = "Please enter a valid 6-digit OTP.";
            return;
        }

        IsLoading = true;

        try
        {
            var result = await Api.VerifyPasswordOtp(
                Email.Trim(),
                OTP.Trim());

            if (result.Success &&
                !string.IsNullOrWhiteSpace(result.ResetToken))
            {
                Navigation.NavigateTo(
                    "/change-password?email=" +
                    Uri.EscapeDataString(Email.Trim()) +
                    "&resetToken=" +
                    Uri.EscapeDataString(result.ResetToken));
            }
            else
            {
                ErrorMessage = result.Message;
            }
        }
        catch
        {
            ErrorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
